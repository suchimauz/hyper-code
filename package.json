{
  "name": "mauzcode",
  "private": true,
  "module": "src/$main.ts",
  "type": "module",
  "scripts": {
    "start": "bun 'src/$main.ts'",
    "repl": "bun script/repl.ts",
    "mauzcode": "bun script/mauzcode.ts",
    "cli": "bun script/cli.ts",
    "extension:watch": "bun script/watch-extension.ts",
    "extension:reload": "bun script/watch-extension.ts --once",
    "test": "bun script/test.ts fast",
    "test:it": "bun script/test.ts it",
    "test:live": "bun script/test.ts live",
    "test:all": "bun script/test.ts all",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "frontend:test": "vitest run --config frontend/vite.config.ts",
    "frontend:storybook": "storybook dev -c frontend/.storybook -p 6006 --host 127.0.0.1 --no-open",
    "frontend:build-storybook": "storybook build -c frontend/.storybook -o frontend/storybook-static"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "happy-dom": "^20.11.2",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "26.1.0",
    "storybook": "10.6.6",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@huggingface/tokenizers": "^0.2.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "htmx.org": "4.0.0",
    "js-tiktoken": "^1.0.21",
    "lru-cache": "^11.5.3",
    "marked": "^18.0.7",
    "medeo-font": "1.0.0-rc.3",
    "parse5": "^8.0.1",
    "shiki": "4.6.0",
    "tailwindcss": "^4.3.3",
    "telegram": "^2.26.22",
    "web-push": "^3.6.7",
    "@base-ui/react": "1.9.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "procs": {
    "plugins": [
      "./plugins"
    ],
    "prod": {
      "procs/log": {},
      "procs/telemetry": {},
      "procs/db": {},
      "procs/migrate": {},
      "auth": {},
      "controlPlane": {},
      "procs/repl": {},
      "external": {},
      "agent": {},
      "cron": {},
      "models": {},
      "tsgo": {},
      "procs/http": {
        "port": 3010
      },
      "h2": {},
      "frontendRuntime": {
        "required": true
      }
    },
    "modules": {
      "browser": {},
      "websearch": {},
      "telegram": {},
      "gh": {},
      "whisper": {
        "path": "plugins/whisper"
      },
      "mauzcode-ui-bridge": false
    }
  }
}
